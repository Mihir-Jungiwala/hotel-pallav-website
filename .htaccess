# ============================================================
# Hotel Pallav — root .htaccess (Apache / Hostinger)
# Kept deliberately conservative: every directive here is either
# module-guarded or in the "FilesMatch/Limit" context that shared
# hosts almost always permit via AllowOverride. Nothing here should
# ever 500 the site, even on a restrictive AllowOverride policy.
# ============================================================

# ----- Custom error pages -----
ErrorDocument 404 /404.php

# ----- Block direct access to sensitive files -----
<IfModule mod_authz_core.c>
  <FilesMatch "\.(sql|env|gitignore|gitattributes|htpasswd)$">
    Require all denied
  </FilesMatch>
  <FilesMatch "^(composer\.json|composer\.lock|package\.json|package-lock\.json|database\.sql|error\.log)$">
    Require all denied
  </FilesMatch>
</IfModule>
<IfModule !mod_authz_core.c>
  <FilesMatch "\.(sql|env|gitignore|gitattributes|htpasswd)$">
    Order allow,deny
    Deny from all
  </FilesMatch>
  <FilesMatch "^(composer\.json|composer\.lock|package\.json|package-lock\.json|database\.sql|error\.log)$">
    Order allow,deny
    Deny from all
  </FilesMatch>
</IfModule>

# ----- Block .git/ (only if mod_rewrite is actually available) -----
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule (^|/)\.git - [F,L]
</IfModule>

# ----- Compression (mod_deflate) -----
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml text/javascript
  AddOutputFilterByType DEFLATE application/javascript application/x-javascript
  AddOutputFilterByType DEFLATE application/json application/xml application/rss+xml
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ----- Cache-Control / Expires for static assets -----
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpg "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/gif "access plus 1 month"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType image/x-icon "access plus 1 month"
  ExpiresByType text/css "access plus 1 week"
  ExpiresByType application/javascript "access plus 1 week"
  ExpiresByType text/javascript "access plus 1 week"
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.(jpg|jpeg|png|gif|webp|svg|ico)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
</IfModule>
